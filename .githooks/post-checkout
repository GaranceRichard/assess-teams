#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  powershell_command=pwsh
  execution_policy=
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell_command=powershell.exe
  execution_policy="-ExecutionPolicy Bypass"
else
  echo "[bootstrap worktree] ECHEC : PowerShell est introuvable." >&2
  exit 1
fi

"$powershell_command" -NoProfile $execution_policy \
  -File "$repo_root/scripts/bootstrap-worktree.ps1" -Root "$repo_root"
