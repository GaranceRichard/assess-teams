#!/bin/sh
repo_root=$(git rev-parse --show-toplevel) || exit 1

if command -v pwsh >/dev/null 2>&1; then
  powershell_command=pwsh
  execution_policy=
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell_command=powershell.exe
  execution_policy="-ExecutionPolicy Bypass"
else
  echo "[FAIL] Garde de contribution: PowerShell est introuvable."
  exit 1
fi

updates=$(cat)

printf '%s\n' "$updates" | "$powershell_command" -NoProfile $execution_policy \
  -File "$repo_root/scripts/quality/check-contribution-workflow.ps1" \
  -Root "$repo_root" -RemoteName "$1"
[ "$?" -eq 0 ] || exit 1

printf '%s\n' "$updates" | node "$repo_root/scripts/quality/selective.mjs" --pre-push
