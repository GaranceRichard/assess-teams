{
  "name": "assess-teams",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "node ./scripts/run-powershell.mjs ./scripts/bootstrap/root.ps1 -QuietIfReady && concurrently --kill-others --names backend,frontend --prefix-colors blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node ./scripts/run-powershell.mjs ./scripts/dev-backend.ps1",
    "dev:frontend": "node ./scripts/run-powershell.mjs ./scripts/dev-frontend.ps1",
    "check:lines": "node ./scripts/run-powershell.mjs ./scripts/quality/check-source-lines.ps1",
    "test:all": "node ./scripts/run-powershell.mjs ./scripts/test-all.ps1",
    "quality:quick": "node ./scripts/quality/quick.mjs",
    "quality:full": "node ./scripts/quality/validate.mjs",
    "dev:demo": "npm run dev:demo --prefix frontend",
    "build:demo": "npm run build:demo --prefix frontend",
    "quality:targeted": "node ./scripts/quality/targeted.mjs",
    "publish": "node ./scripts/run-powershell.mjs ./scripts/publish.ps1",
    "quality:check": "node ./scripts/quality/selective.mjs",
    "quality:plan": "node ./scripts/quality/selective.mjs --plan",
    "quality:qualify": "node ./scripts/quality/qualification.mjs local",
    "quality:promote": "node ./scripts/quality/qualification.mjs promote",
    "quality:benchmark": "node ./scripts/quality/benchmark.mjs"
  },
  "devDependencies": {
    "concurrently": ">=9.2.0 <10"
  }
}
